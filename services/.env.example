# Used when running the services locally WITHOUT Docker (Exercise 4).
# In Docker Compose (Exercise 5) these are set as environment: entries
# in docker-compose.yml instead, using service names as hostnames.

# app_service
RAG_SERVICE_URL=http://localhost:8001
LLM_SERVICE_URL=http://localhost:8002
SERVICE_TIMEOUT_SECONDS=120

# rag_service / data_service (must point to the SAME folder)
EMBEDDINGS_DIR=./shared_embeddings

# llm_service
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=codellama
OLLAMA_TIMEOUT_SECONDS=120
